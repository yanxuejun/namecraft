---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Contact Us';
const description = 'Get in touch with WhatMeans.name. We would love to hear from you. Send us your questions, feedback, or collaboration ideas.';
---

<Layout title={title} description={description} canonical="/contact">
  <Header />

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-br from-brand-dark to-brand-dark/90 py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-1 rounded-full bg-brand-coral/20 text-brand-coral text-sm font-medium mb-4">
          Get in Touch
        </span>
        <h1 class="font-display font-bold text-4xl md:text-5xl text-white mb-4">
          Contact Us
        </h1>
        <p class="text-lg text-white/60 max-w-2xl mx-auto">
          Have a question, suggestion, or just want to say hello? We would love to hear from you.
        </p>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h2 class="font-display font-bold text-3xl text-brand-dark mb-6">Let's Talk</h2>
            <p class="text-brand-dark/60 leading-relaxed mb-8">
              Whether you have a question about baby names, want to suggest a feature, or are interested in collaborating,
              we're here to help. Reach out and we'll get back to you as soon as possible.
            </p>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-coral/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-brand-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-brand-dark mb-1">Email</h3>
                <a href="mailto:hello@whatmeans.name" class="text-brand-dark/60 hover:text-brand-coral transition-colors">hello@whatmeans.name</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-coral/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-brand-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-brand-dark mb-1">Response Time</h3>
                <p class="text-brand-dark/60">We typically respond within 24-48 hours on business days.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-brand-coral/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-brand-coral" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-brand-dark mb-1">Location</h3>
                <p class="text-brand-dark/60">United States</p>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div>
            <h3 class="font-semibold text-brand-dark mb-4">Follow Us</h3>
            <div class="flex gap-4">
              <a href="https://instagram.com/whatmeans.name" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-xl bg-brand-cream flex items-center justify-center text-brand-dark/60 hover:bg-brand-coral hover:text-white transition-all">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </a>
              <a href="https://tiktok.com/@whatmeans.name" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-xl bg-brand-cream flex items-center justify-center text-brand-dark/60 hover:bg-brand-coral hover:text-white transition-all">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
                </svg>
              </a>
              <a href="https://pinterest.com/whatmeansname" target="_blank" rel="noopener noreferrer" class="w-12 h-12 rounded-xl bg-brand-cream flex items-center justify-center text-brand-dark/60 hover:bg-brand-coral hover:text-white transition-all">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100">
          <h3 class="font-display font-bold text-2xl text-brand-dark mb-6">Send a Message</h3>
          <form class="space-y-6" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
            <div>
              <label for="name" class="block text-sm font-medium text-brand-dark mb-2">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-brand-cream/50 text-brand-dark placeholder-brand-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-coral/50 focus:border-transparent transition-all"
                placeholder="Jane Doe"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-brand-dark mb-2">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-brand-cream/50 text-brand-dark placeholder-brand-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-coral/50 focus:border-transparent transition-all"
                placeholder="jane@example.com"
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-brand-dark mb-2">Subject</label>
              <select
                id="subject"
                name="subject"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-brand-cream/50 text-brand-dark focus:outline-none focus:ring-2 focus:ring-brand-coral/50 focus:border-transparent transition-all"
              >
                <option value="general">General Inquiry</option>
                <option value="feedback">Feedback</option>
                <option value="collaboration">Collaboration</option>
                <option value="bug">Bug Report</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-brand-dark mb-2">Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-brand-cream/50 text-brand-dark placeholder-brand-dark/30 focus:outline-none focus:ring-2 focus:ring-brand-coral/50 focus:border-transparent transition-all resize-none"
                placeholder="Tell us what's on your mind..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center px-8 py-4 bg-brand-coral text-white font-semibold rounded-full hover:bg-opacity-90 transition-all hover:shadow-lg"
            >
              Send Message
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>
            <p class="text-xs text-brand-dark/40 text-center">
              By submitting this form, you agree to our <a href="/privacy" class="text-brand-coral hover:underline">Privacy Policy</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

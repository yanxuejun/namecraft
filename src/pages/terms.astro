---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms of Service';
const description = 'WhatMeans.name Terms of Service — the rules and regulations for using our website.';
---

<Layout title={title} description={description} canonical="/terms">
  <Header />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero -->
    <div class="text-center mb-12">
      <span class="inline-block px-4 py-1 rounded-full bg-brand-coral/10 text-brand-coral text-sm font-medium mb-4">
        Legal
      </span>
      <h1 class="font-display font-bold text-4xl md:text-5xl text-brand-dark mb-4">
        Terms of Service
      </h1>
      <p class="text-brand-dark/60">
        Last updated: June 4, 2026
      </p>
    </div>

    <div class="bg-white rounded-2xl p-8 md:p-12 border border-gray-100 space-y-10">
      <section>
        <h2 class="font-display font-bold text-2xl text-brand-dark mb-4">1. Agreement to Terms</h2>
        <p class="text-brand-dark/70 leading-relaxed">
          These Terms of Service constitute a legally binding agreement made between you and WhatMeans.name
          ("we," "us," or "our"), concerning your access to and use of the whatmeans.name website as well as any

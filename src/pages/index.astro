---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NameCloud from '../components/NameCloud.astro';
import TrendCard from '../components/TrendCard.astro';
import { trendingNames2026, inventedNames, dramaticNames, topSpellingSearches } from '../data/names.js';

const title = 'WhatMeans';
const description = 'Discover 2026 baby name trends, unique meanings, creative spellings, and find the perfect name for your little one.';
---

<Layout title={title} description={description} canonical="/">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
      <!-- Background -->
      <div class="absolute inset-0 bg-gradient-to-br from-brand-cream via-white to-brand-coral/5"></div>
      <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-bl from-brand-yellow/10 to-transparent"></div>

      <!-- Floating name elements -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <span class="absolute top-20 left-[10%] text-4xl md:text-6xl font-display font-bold text-brand-coral/10 animate-float">Brooks</span>
        <span class="absolute top-40 right-[15%] text-3xl md:text-5xl font-display font-bold text-brand-yellow/20 animate-float animation-delay-200">Harlow</span>
        <span class="absolute bottom-32 left-[20%] text-2xl md:text-4xl font-display font-bold text-brand-dark/5 animate-float animation-delay-400">Raya</span>
        <span class="absolute bottom-20 right-[25%] text-xl md:text-3xl font-display font-bold text-brand-coral/10 animate-float animation-delay-600">Artemis</span>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto text-center px-4 sm:px-6">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-coral/10 text-brand-coral text-sm font-medium mb-8">
          <span class="w-2 h-2 rounded-full bg-brand-coral animate-pulse"></span>
          2026 Baby Name Trends Report
        </div>

        <h1 class="font-display font-bold text-5xl md:text-7xl lg:text-8xl text-brand-dark leading-tight mb-6">
          Find the Name<br />
          <span class="text-gradient">They Deserve</span>
        </h1>

        <p class="text-lg md:text-xl text-brand-dark/60 max-w-2xl mx-auto mb-10 leading-relaxed">
          From timeless classics to creative inventions like <em>Billiam</em> and <em>Iso</em>,
          explore what American parents are searching in 2026.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/trends/2026" class="btn-primary text-lg">
            Explore 2026 Trends
          </a>
          <a href="/spelling" class="btn-secondary text-lg">
            Spelling Studio
          </a>
        </div>

        <!-- Mini stats -->
        <div class="flex flex-wrap justify-center gap-8 text-center">
          <div>
            <div class="font-mono font-bold text-2xl text-brand-coral">Top 5</div>
            <div class="text-sm text-brand-dark/50">Trending Names</div>
          </div>
          <div>
            <div class="font-mono font-bold text-2xl text-brand-coral">250%</div>
            <div class="text-sm text-brand-dark/50">Artemis Growth</div>
          </div>
          <div>
            <div class="font-mono font-bold text-2xl text-brand-coral">Record</div>
            <div class="text-sm text-brand-dark/50">Double Name Searches</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Trend Cards -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="text-center mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl text-brand-dark mb-4">
          What's Trending in 2026
        </h2>
        <p class="text-brand-dark/60 max-w-xl mx-auto">
          The hottest naming movements shaping how American parents choose names this year.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <TrendCard
          title="Double Name Revival"
          description="Mary-Anne, Anna-Marie and more — double names are at an all-time high. Search volumes broke records this year."
          icon="🔥"
          href="/double-names"
          stat="Record High"
          color="coral"
        />
        <TrendCard
          title="Invented Names"
          description="Is Billiam a name? Is Iso? Parents are getting creative with entirely new words as baby names in 2026."
          icon="✨"
          href="/trends/2026#invented"
          stat="Viral"
          color="yellow"
        />
        <TrendCard
          title="Dramatic Meanings"
          description="Girl names meaning chaos and boy names meaning darkness are among the hottest semantic searches this year."
          icon="🎭"
          href="/trends/2026#dramatic"
          stat="+180%"
          color="purple"
        />
      </div>
    </section>

    <!-- Interactive Name Cloud -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-brand-dark mb-2">
            2026 Name Cloud
          </h2>
          <p class="text-brand-dark/60">
            Click any name to explore its meaning, origin, and popularity.
          </p>
        </div>
        <a href="/name" class="text-brand-coral font-medium hover:underline">
          View all names →
        </a>
      </div>
      <NameCloud />
    </section>

    <!-- Top 5 Trending Names -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="inline-block px-4 py-1 rounded-full bg-brand-coral/10 text-brand-coral text-sm font-medium mb-4">
            YTD 2026
          </span>
          <h2 class="font-display font-bold text-3xl md:text-4xl text-brand-dark mb-4">
            Top 5 Most Searched Name Meanings
          </h2>
          <p class="text-brand-dark/60 max-w-xl mx-auto">
            The names Americans are most curious about this year.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
          {trendingNames2026.map((name, index) => (
            <a
              href={`/name/${name.name.toLowerCase()}`}
              class="group relative bg-brand-cream rounded-2xl p-6 text-center card-hover border border-transparent hover:border-brand-coral/20"
            >
              <div class="absolute -top-3 -right-3 w-8 h-8 rounded-full bg-brand-coral text-white flex items-center justify-center font-mono font-bold text-sm shadow-lg">
                #{name.rank}
              </div>
              <h3 class="font-display font-bold text-2xl text-brand-dark mb-1 group-hover:text-brand-coral transition-colors">
                {name.name}
              </h3>
              <p class="text-xs text-brand-dark/40 mb-3 uppercase tracking-wider">{name.gender}</p>
              <p class="text-sm text-brand-dark/60 mb-3 line-clamp-2">{name.meaning}</p>
              <span class="inline-flex items-center px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-mono font-bold">
                {name.trend}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Fun Data Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Is It a Name? -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">🤔</span>
            <h3 class="font-display font-bold text-2xl text-brand-dark">Is It a Name?</h3>
          </div>
          <p class="text-brand-dark/60 mb-6">
            The most searched "is [word] a name" queries of 2026 — reflecting America's curiosity about creative naming.
          </p>
          <div class="space-y-3">
            {inventedNames.map(item => (
              <a
                href={`/name/${item.name.toLowerCase()}`}
                class="flex items-center justify-between p-4 rounded-xl bg-brand-cream hover:bg-brand-coral/5 transition-colors group"
              >
                <div class="flex items-center gap-3">
                  <span class="font-display font-bold text-lg text-brand-dark group-hover:text-brand-coral">{item.name}</span>
                  {item.invented && (
                    <span class="px-2 py-0.5 rounded-full bg-brand-yellow/30 text-amber-700 text-xs font-medium">Invented</span>
                  )}
                </div>
                <span class="text-brand-dark/30 group-hover:text-brand-coral">→</span>
              </a>
            ))}
          </div>
          <a href="/is-it-a-name" class="inline-flex items-center mt-6 text-brand-coral font-medium hover:underline">
            Check any name →
          </a>
        </div>

        <!-- Regional Differences -->
        <div class="bg-white rounded-2xl p-8 border border-gray-100">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-3xl">🗺️</span>
            <h3 class="font-display font-bold text-2xl text-brand-dark">State by State</h3>
          </div>
          <p class="text-brand-dark/60 mb-6">
            Fascinating regional preferences reveal how geography shapes baby name culture across America.
          </p>
          <div class="space-y-4">
            <div class="p-4 rounded-xl bg-brand-cream">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-semibold text-brand-dark">Washington</span>
                <span class="text-brand-dark/40">is the only state where</span>
              </div>
              <p class="font-display font-bold text-xl text-brand-coral">Jaxon &gt; Braxton &amp; Paxton</p>
            </div>
            <div class="p-4 rounded-xl bg-brand-cream">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-semibold text-brand-dark">West Coast</span>
                <span class="text-brand-dark/40">searches</span>
              </div>
              <p class="font-display font-bold text-xl text-brand-coral">Aiden</p>
              <p class="text-sm text-brand-dark/40 mt-1">while East Coast prefers Jayden</p>
            </div>
            <div class="p-4 rounded-xl bg-brand-cream">
              <div class="flex items-center gap-2 mb-2">
                <span class="font-semibold text-brand-dark">Texas</span>
                <span class="text-brand-dark/40">is the only state where</span>
              </div>
              <p class="font-display font-bold text-xl text-brand-coral">Katy &gt; Katie</p>
            </div>
          </div>
          <a href="/trends/2026#regional" class="inline-flex items-center mt-6 text-brand-coral font-medium hover:underline">
            Explore regional data →
          </a>
        </div>
      </div>
    </section>

    <!-- Dramatic Names + Spelling -->
    <section class="bg-white py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Dramatic Names -->
          <div>
            <h3 class="font-display font-bold text-2xl text-brand-dark mb-2">Dramatic Name Meanings</h3>
            <p class="text-brand-dark/60 mb-6">Parents are drawn to names with bold, powerful connotations.</p>

            <div class="space-y-6">
              <div>
                <h4 class="font-semibold text-brand-dark mb-3 flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xs">♀</span>
                  Names Meaning Chaos
                </h4>
                <div class="flex flex-wrap gap-2">
                  {dramaticNames.chaos.map(n => (
                    <a href={`/name/${n.name.toLowerCase()}`} class="px-4 py-2 rounded-full bg-red-50 text-red-700 text-sm font-medium hover:bg-red-100 transition-colors">
                      {n.name}
                    </a>
                  ))}
                </div>
              </div>
              <div>
                <h4 class="font-semibold text-brand-dark mb-3 flex items-center gap-2">
                  <span class="w-6 h-6 rounded-full bg-gray-100 text-gray-700 flex items-center justify-center text-xs">♂</span>
                  Names Meaning Darkness
                </h4>
                <div class="flex flex-wrap gap-2">
                  {dramaticNames.darkness.map(n => (
                    <a href={`/name/${n.name.toLowerCase()}`} class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 text-sm font-medium hover:bg-gray-200 transition-colors">
                      {n.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <!-- Spelling Variations -->
          <div>
            <h3 class="font-display font-bold text-2xl text-brand-dark mb-2">Creative Spellings</h3>
            <p class="text-brand-dark/60 mb-6">Alternative spellings are at an all-time high. Top searched variations:</p>

            <div class="space-y-4">
              {topSpellingSearches.map(item => (
                <a href={`/spelling/${item.name.toLowerCase()}`} class="block p-4 rounded-xl bg-brand-cream hover:bg-brand-coral/5 transition-colors group">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-4">
                      <span class="w-8 h-8 rounded-full bg-brand-coral/10 text-brand-coral flex items-center justify-center font-mono font-bold text-sm">
                        {item.rank}
                      </span>
                      <span class="font-display font-bold text-lg text-brand-dark group-hover:text-brand-coral">{item.name}</span>
                    </div>
                    <span class="text-brand-dark/30 group-hover:text-brand-coral">→</span>
                  </div>
                </a>
              ))}
            </div>
            <a href="/spelling" class="inline-flex items-center mt-6 text-brand-coral font-medium hover:underline">
              Try Spelling Studio →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="relative bg-gradient-to-br from-brand-dark to-brand-dark/90 rounded-3xl p-12 md:p-16 text-center overflow-hidden">
        <div class="absolute inset-0 opacity-10">
          <div class="absolute top-10 left-10 text-6xl font-display font-bold text-white">Brooks</div>
          <div class="absolute bottom-10 right-10 text-5xl font-display font-bold text-white">Harlow</div>
          <div class="absolute top-1/2 left-1/4 text-4xl font-display font-bold text-white">Milo</div>
        </div>
        <div class="relative z-10">
          <h2 class="font-display font-bold text-3xl md:text-5xl text-white mb-4">
            Ready to Find the Perfect Name?
          </h2>
          <p class="text-white/70 max-w-xl mx-auto mb-8 text-lg">
            Explore meanings, generate creative spellings, or discover double-name combinations.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/name" class="inline-flex items-center justify-center px-8 py-4 bg-brand-coral text-white font-semibold rounded-full hover:bg-opacity-90 transition-all">
              Browse Names
            </a>
            <a href="/double-names" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 text-white font-semibold rounded-full hover:bg-white/20 transition-all backdrop-blur-sm">
              Generate Double Names
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
